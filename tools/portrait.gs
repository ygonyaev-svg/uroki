/* ===== Портрет ребёнка: события из таблицы для родителя на любом устройстве (добавлено в Код.gs, версия 12, 21.11.2026) =====
   doGet, первой строкой: if (e && e.parameter && e.parameter.action === 'pf') { try { return snapOut_(pfGet_(String(e.parameter.kid || ''))); } catch (_p) { return snapOut_({ ok: false }); } }
   famRoute_, перед d.fam === 'ev': if (d.fam === 'pf') return famPf_(a.row[0]);
   Строка ответа: [время мс, ребёнок, событие, предмет, вопрос(40), итог, счёт, сл/мин, точность, текст(80)]. */
function pfTs_(t){ return t instanceof Date ? t.getTime() : (Date.parse(t) || 0); }
function pfGet_(kid){ if (!kid) return { ok: false }; var v = SpreadsheetApp.openById(SID).getSheetByName('События').getDataRange().getValues(), out = []; for (var i = 1; i < v.length; i++) { var r = v[i]; if (String(r[1]) !== kid) continue; out.push([pfTs_(r[0]), kid, String(r[2]), String(r[3]), String(r[5]).slice(0, 40), String(r[8]), String(r[9]).slice(0, 40), r[10] === '' ? '' : r[10], String(r[11]), String(r[12]).slice(0, 80)]); } return { ok: true, rows: out.slice(-8000) }; }
function famPf_(fid){ var v = famSh('События').getDataRange().getValues(), out = []; for (var i = 1; i < v.length; i++) { var r = v[i]; if (String(r[1]) !== String(fid)) continue; var x = {}; try { x = JSON.parse(r[5] || '{}'); } catch (_e) {} out.push([pfTs_(r[0]), String(r[3]), String(r[4]), String(x.subj || ''), String(x.q || '').slice(0, 40), String(x.ok || ''), String(x.score || '').slice(0, 40), x.wpm || '', String(x.acc || ''), String(x.text || '').slice(0, 80)]); } return { ok: true, rows: out.slice(-8000) }; }
